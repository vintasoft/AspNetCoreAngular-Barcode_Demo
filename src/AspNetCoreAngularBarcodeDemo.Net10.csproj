<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<SpaRoot>ClientApp\</SpaRoot>
		<SpaProxyServerUrl>https://localhost:44406</SpaProxyServerUrl>
		<SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultItems>false</EnableDefaultItems>
	</PropertyGroup>

	<Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
		<!-- Ensure Node.js is installed -->
		<Exec Command="node --version" ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
		</Exec>
		<Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
		<Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
	</Target>

	<Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
		<!-- As part of publishing, ensure the JS resources are freshly built in production mode -->
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production" />

		<!-- Include the newly-built files in the publish output -->
		<ItemGroup>
			<DistFiles Include="$(SpaRoot)dist\**; $(SpaRoot)dist-server\**" />
			<ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- Don't publish the SPA source files, but do show them in the project files list -->
		<Content Remove="$(SpaRoot)**" />
		<None Remove="$(SpaRoot)**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.0" />
		<PackageReference Include="SkiaSharp" Version="4.151.1" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Vintasoft.Barcode" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Barcode.AI.1D" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Barcode.AI.2D" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Barcode.SkiaSharp" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Barcode.Web.Services" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Barcode.AspNetCore.ApiControllers" Version="16.1.0.1" />
    <PackageReference Include="Vintasoft.Shared" Version="4.7.0.1" />
    <PackageReference Include="Vintasoft.Shared.Web" Version="4.7.0.1" />
	</ItemGroup>
<ItemGroup>
  <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  <Compile Include="Controllers\FileUploadResponseParams.cs" />
  <Compile Include="Controllers\MyVintasoftBarcodeApiController.cs" />
  <Compile Include="Controllers\MyVintasoftBarcodeWebService.cs" />
  <Compile Include="Controllers\SessionController.cs" />
  <Compile Include="Program.cs" />
  <Content Include="appsettings.Development.json" />
  <Content Include="appsettings.json" />
  <Content Include="Properties\launchSettings.json" />
  <Content Include="wwwroot\favicon.ico" />
  <Content Include="wwwroot\Images\fileUploadProgress.gif" />
  <Content Include="wwwroot\Images\vsbarcode-icon.gif" />
  <Content Include="wwwroot\UploadedImageFiles\AllSupportedBarcodes.png" />
  <None Include=".gitignore" />
</ItemGroup>
	
</Project>
